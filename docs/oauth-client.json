{
  "client_id": "gorth-launcher-website",
  "name": "Gorth Launcher Website",
  "client_secret": null,
  "public": true,
  "application_type": "web",
  "require_pkce": true,
  "token_endpoint_auth_method": "none",
  "enable_end_session": true,
  "grant_types": ["authorization_code", "refresh_token"],
  "response_types": ["code"],
  "scopes": ["openid", "profile", "email", "offline_access"],
  "redirect_uris": ["http://localhost:5504/auth/callback/gorth"],
  "post_logout_redirect_uris": ["http://localhost:5504"],
  "backchannel_logout_uri": "http://localhost:5504/auth/backchannel-logout",
  "backchannel_logout_session_required": true
}
