# Copy to .env.local and fill real values. Never commit secrets.
# Same-origin React/Vite + Hono. Public settings use VITE_PUBLIC_*; server-only settings have no VITE_ prefix.
# Vite injects only the public cookie prefix and SSO URL; credentials never enter the client bundle.
NODE_ENV=development
VITE_PUBLIC_APP_URL=http://localhost:5504
VITE_PUBLIC_AUTH_URL=https://gorth-auth.vercel.app
VITE_PUBLIC_OAUTH_CLIENT_ID=gorth-launcher-website
OAUTH_COOKIE_PREFIX=gorth
# Required server-only secret (at least 32 bytes). Generate separately per app:
# openssl rand -base64 48
# Retain the existing value if this app already stores encrypted OAuth tokens.
SESSION_SECRET=
# Minecraft texture signing only: PKCS#8 RSA private PEM encoded as base64.
# Required to issue online game sessions; never expose as VITE_PUBLIC_*.
MINECRAFT_SIGNING_PRIVATE_KEY_BASE64=
SESSION_MAX_AGE_SECONDS=2592000

OAUTH_AUDIENCE=http://localhost:5504

OAUTH_NOTIFY_AUDIENCE=
OAUTH_RESOURCE_AUDIENCE=
OAUTH_DISCOVERY_AUDIENCE=
OAUTH_PAYMENT_AUDIENCE=
OAUTH_BILLING_AUDIENCE=
OAUTH_MEDIA_AUDIENCE=
OAUTH_INSIGHT_AUDIENCE=

# Optional: leave blank until a release is actually published.
RELEASE_VERSION=
DOWNLOAD_MACOS_ARM64_URL=
DOWNLOAD_MACOS_X64_URL=
DOWNLOAD_WINDOWS_X64_URL=
DOWNLOAD_LINUX_X64_URL=

# Persistent DB-backed rate limit. Tune the deployment policy before enabling.
RATE_LIMIT_ENABLED=false

# Required: this website's PostgreSQL connection string, never the SSO database.
DATABASE_URL=

